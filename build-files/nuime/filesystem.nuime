<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="https://nuime.org/schema/core/1">
  <name>filesystem</name>
  <targets>
    <target>
      <name>filesystem-lib</name>
      <labels>
        <label>nuime:product</label>
      </labels>
      <build-dependencies>
        <dependency>
          <name>io</name>
          <target-refs>
            <target-ref>
              <location>
                <url>https://github.com/ishiko-cpp/io/build-files/nuime/io.nuime</url>
              </location>
              <name>io-lib</name>
            </target-ref>
          </target-refs>
        </dependency>
        <dependency>
          <name>errors</name>
          <target-refs>
            <target-ref>
              <location>
                <url>https://github.com/ishiko-cpp/errors/build-files/nuime/errors.nuime</url>
              </location>
              <name>errors-lib</name>
            </target-ref>
          </target-refs>
        </dependency>
        <dependency>
          <name>base-platform</name>
          <target-refs>
            <target-ref>
              <location>
                <url>https://github.com/ishiko-cpp/base-platform/build-files/nuime/base-platform.nuime</url>
              </location>
              <name>base-platform-lib</name>
            </target-ref>
          </target-refs>
        </dependency>
      </build-dependencies>
      <properties>
        <property name="nuime:test-suite">
          <target-ref>
            <location>
              <url>https://github.com/ishiko-cpp/filesystem/tests/build-files/nuime/filesystem-tests.nuime</url>
            </location>
            <name>filesystem-tests</name>
          </target-ref>
        </property>
      </properties>
    </target>
  </targets>
  <subprojects>
    <subproject>
      <name>filesystem-tests</name>
      <labels>
        <label>nuime:tests</label>
      </labels>
      <location>
        <url>https://github.com/ishiko-cpp/filesystem/tests/build-files/nuime/filesystem-tests.nuime</url>
      </location>
    </subproject>
  </subprojects>
</project>
